{
  "name": "project-era",
  "private": true,
  "version": "0.1.0",
  "description": "ProjectEra — original city action sandbox desktop game",
  "author": "ProjectEra",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "vite & sleep 1 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win --mac",
    "dist:win": "npm run build && electron-builder --win portable nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "com.projectera.desktop",
    "productName": "ProjectEra",
    "copyright": "Copyright © ProjectEra",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "ProjectEra-${version}-Windows-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ProjectEra-${version}-Windows-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.games",
      "artifactName": "ProjectEra-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Game",
      "artifactName": "ProjectEra-${version}-Linux-${arch}.${ext}"
    }
  }
}
